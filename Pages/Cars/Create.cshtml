@page
@model CarManagementSystem.Pages.Cars.CreateModel
@{
    ViewData["Title"] = "Add car";
}
<div class="page-header"><div><p class="eyebrow">YOUR COLLECTION</p><h1>Add a car</h1></div></div>
<div class="card p-4 p-md-5">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_CarForm" model="Model.Car" />
        <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Save car</button><a class="btn btn-outline-secondary" asp-page="Index">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
